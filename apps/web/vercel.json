{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && NODE_OPTIONS=--max-old-space-size=3072 pnpm turbo run build --filter=@ws/web --ui=stream --concurrency=1",
  "outputDirectory": ".next",
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "regions": [
    "fra1"
  ]
}
