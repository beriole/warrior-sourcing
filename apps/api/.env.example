NODE_ENV=development
PORT=4000

# PostgreSQL local. Remplacez MOT_DE_PASSE par le mot de passe de votre utilisateur postgres.
DATABASE_URL=postgresql://postgres:MOT_DE_PASSE@localhost:5432/warrior_sourcing

# Redis : pas encore nécessaire. À renseigner quand les files de tâches (BullMQ) arriveront.
# REDIS_URL=redis://localhost:6379

WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001

# ── Notifications email ──
APP_URL=http://localhost:3000
# Sans clé Resend, les emails sont écrits dans apps/api/.mail au lieu d'être envoyés.
# RESEND_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM="Warrior Sourcing <onboarding@resend.dev>"
MAIL_SUPPORT_ADDRESS=support@warrior-sourcing.cm
MAIL_TEST_RECIPIENT=berioletsague@gmail.com
MAIL_OUTBOX_DIR=.mail

# ── Authentification ──
API_URL=http://localhost:4000
# openssl rand -base64 48
AUTH_SECRET=dev-secret-a-remplacer-absolument-en-production

# Portée du cookie de session : `lax` ou `none`.
# En local, le site et l'API partagent localhost : `lax` suffit.
# En production, si le site et l'API ne sont PAS sur le même domaine, mettre `none` —
# sinon le navigateur n'envoie jamais le cookie et l'utilisateur paraît déconnecté en
# permanence, sans la moindre erreur visible. `none` impose HTTPS.
AUTH_COOKIE_SAMESITE=lax

# ── Paiement Mobile Money (Fapshi) ──
# `sandbox` utilise les clés _SANDBOX ci-dessous ; `live` utilise les clés sans suffixe.
# Sans clés, l'API bascule sur un agrégateur en mémoire : aucun paiement réel n'est lancé.
FAPSHI_ENV=sandbox
FAPSHI_BASE_URL_SANDBOX=https://sandbox.fapshi.com
FAPSHI_API_USER_SANDBOX=
FAPSHI_API_KEY_SANDBOX=
FAPSHI_BASE_URL=
FAPSHI_API_USER=
FAPSHI_API_KEY=
# Doit être **identique** à la valeur saisie dans le tableau de bord Fapshi, à côté de
# l'URL de webhook. Laissée vide, tous les webhooks sont rejetés en 401 : les paiements
# ne sont alors confirmés que par la relecture d'état (réconciliation et consultation),
# ce qui fonctionne mais avec du retard.
# openssl rand -base64 32
FAPSHI_WEBHOOK_SECRET=

# Réconciliation périodique des paiements en attente, en millisecondes.
# Absente ou 0 : désactivée. Plancher appliqué : 30 000 ms.
# PAYMENTS_RECONCILE_INTERVAL_MS=60000

# ── Fonctions IA (lot AI) ──
# Sans clé, l'assistant se désactive proprement : l'écran ne le propose pas,
# et rien d'autre ne tombe.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Le nom doit exister chez OpenRouter : https://openrouter.ai/models
# En changer ne demande aucun déploiement, c'est tout l'intérêt de la passerelle.
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
