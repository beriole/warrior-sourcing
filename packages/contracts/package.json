{
  "name": "@ws/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Schémas Zod, énumérations métier et calculs partagés entre le front, l'admin et l'API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@ws/tsconfig": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
